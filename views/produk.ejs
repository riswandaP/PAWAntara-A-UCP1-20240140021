<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="page-heading">
      <h1>Daftar Produk</h1>
    </section>

    <section class="filter-bar" aria-label="Filter produk">
      <form action="/produk" method="GET" class="filter-form">
        <div class="filter-form__group">
          <label for="search">Cari nama produk</label>
          <input
            type="text"
            id="search"
            name="search"
            placeholder="Contoh: beras"
            value="<%= currentSearch %>"
          />
        </div>

        <div class="filter-form__group">
          <label for="kategori">Kategori</label>
          <select id="kategori" name="kategori">
            <option value="">Semua kategori</option>
            <% categories.forEach(function (cat) { %>
              <option value="<%= cat %>" <%= currentKategori === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }) %>
          </select>
        </div>

        <button type="submit" class="btn btn--primary">Terapkan Filter</button>
        <a href="/produk" class="btn btn--secondary">Reset</a>
      </form>
    </section>

    <section class="product-list" aria-label="Hasil produk">
      <% if (products.length === 0) { %>
        <p class="empty-state">Tidak ada produk yang cocok dengan filter Anda.</p>
      <% } else { %>
        <table class="product-table">
          <caption class="sr-only">Tabel daftar produk sembako</caption>
          <thead>
            <tr>
              <th scope="col">Nama Produk</th>
              <th scope="col">Kategori</th>
              <th scope="col">Harga</th>
              <th scope="col">Stok</th>
              <th scope="col">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function (product) { %>
              <tr>
                <td><%= product.name %></td>
                <td><%= product.category %></td>
                <td>Rp <%= product.price.toLocaleString('id-ID') %></td>
                <td><%= product.stock %></td>
                <td>
                  <a href="/produk/<%= product.id %>" class="btn btn--secondary btn--sm">
                    Detail
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
