<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %> | Toko Sembako Ibu Aries</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("partials/navbar") %>

    <main>

        <section class="product-page">
            <div class="container">

                <header class="section-header">
                    <span class="section-label">
                        Katalog
                    </span>

                    <h1>
                        Daftar Produk
                    </h1>

                    <p>
                        Temukan berbagai kebutuhan sembako
                        yang tersedia di Toko Sembako Ibu Aries.
                    </p>
                </header>


                <!-- Filter Produk -->

                <section class="product-filter">

                    <header>
                        <h2>
                            Cari Produk
                        </h2>
                    </header>

                    <form action="/produk" method="GET">

                        <div class="form-group">

                            <label for="search">
                                Nama Produk
                            </label>

                            <input
                                type="search"
                                id="search"
                                name="search"
                                placeholder="Contoh: beras"
                                value="<%= search %>"
                            >

                        </div>


                        <div class="form-group">

                            <label for="kategori">
                                Kategori
                            </label>

                            <select
                                id="kategori"
                                name="kategori"
                            >
                                <option value="">
                                    Semua Kategori
                                </option>

                                <option
                                    value="sembako"
                                    <%= kategori === "sembako" ? "selected" : "" %>
                                >
                                    Sembako
                                </option>
                            </select>

                        </div>


                        <button
                            type="submit"
                            class="btn"
                        >
                            Filter Produk
                        </button>

                    </form>

                </section>


                <!-- Daftar Produk -->

                <section class="product-list">

                    <header class="section-header">
                        <h2>
                            Produk Tersedia
                        </h2>

                        <p>
                            Menampilkan
                            <strong><%= products.length %></strong>
                            produk.
                        </p>
                    </header>


                    <% if (products.length > 0) { %>

                        <div class="product-grid">

                            <% products.forEach(product => { %>

                                <article class="product-card">

                                    <header>
                                        <h3>
                                            <%= product.name %>
                                        </h3>
                                    </header>

                                    <p>
                                        Kategori:
                                        <strong>
                                            <%= product.category %>
                                        </strong>
                                    </p>

                                    <p>
                                        Harga:
                                        <strong>
                                            Rp <%= product.price.toLocaleString("id-ID") %>
                                        </strong>
                                    </p>

                                    <p>
                                        Stok:
                                        <strong>
                                            <%= product.stock %>
                                        </strong>
                                    </p>

                                    <a
                                        href="/produk/<%= product.id %>"
                                        class="btn"
                                    >
                                        Lihat Detail
                                    </a>

                                </article>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <article class="not-found-card">

                            <h2>
                                Produk Tidak Ditemukan
                            </h2>

                            <p>
                                Tidak ada produk yang sesuai
                                dengan pencarian Anda.
                            </p>

                            <a
                                href="/produk"
                                class="btn"
                            >
                                Tampilkan Semua Produk
                            </a>

                        </article>

                    <% } %>

                </section>

            </div>
        </section>

    </main>

    <%- include("partials/footer") %>

    <script src="/js/main.js"></script>

</body>

</html>