<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="hero">
      <div class="hero__content">
        <h1>Belanja Sembako Jadi Lebih Mudah</h1>
        <p>
          Toko Ibu Aries menyediakan kebutuhan sehari-hari dengan harga
          bersahabat dan stok yang selalu terjaga.
        </p>
        <a href="/produk" class="btn btn--primary">Lihat Semua Produk</a>
      </div>
    </section>

    <section class="preview" aria-labelledby="preview-heading">
      <h2 id="preview-heading">Produk Pilihan</h2>

      <div class="card-grid">
        <% previewProducts.forEach(function (product) { %>
          <article class="card">
            <h3 class="card__title"><%= product.name %></h3>
            <p class="card__category"><%= product.category %></p>
            <p class="card__price">Rp <%= product.price.toLocaleString('id-ID') %></p>
            <p class="card__stock">Stok: <%= product.stock %></p>
            <a href="/produk/<%= product.id %>" class="btn btn--secondary">Lihat Detail</a>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
