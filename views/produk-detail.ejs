<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="product-detail">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Beranda</a> / <a href="/produk">Produk</a> / <span><%= product.name %></span>
      </nav>

      <article class="product-detail__card">
        <h1><%= product.name %></h1>
        <dl class="product-detail__info">
          <dt>Kategori</dt>
          <dd><%= product.category %></dd>

          <dt>Harga</dt>
          <dd>Rp <%= product.price.toLocaleString('id-ID') %></dd>

          <dt>Stok</dt>
          <dd><%= product.stock %> unit</dd>
        </dl>

        <a href="/produk" class="btn btn--secondary">Kembali ke Daftar Produk</a>
      </article>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
